<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#161B22"
    android:layout_marginBottom="8dp">

    <TextView
        android:id="@+id/pageNumber"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="صفحة 1"
        android:textColor="#58A6FF"
        android:textSize="16sp" />

    <ImageView
        android:id="@+id/pageImage"
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:scaleType="centerCrop"
        android:src="@drawable/ic_launcher_foreground" />

    <TextView
        android:id="@+id/rawText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="النص الأصلي: ..."
        android:textColor="#C9D1D9"
        android:textSize="14sp" />

    <EditText
        android:id="@+id/correctedText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#0D1117"
        android:padding="8dp"
        android:textColor="#C9D1D9"
        android:textSize="14sp" />

    <Button
        android:id="@+id/fixBtn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="إصلاح"
        android:backgroundTint="#1F6FEB"
        android:textColor="#FFFFFF" />

</LinearLayout>